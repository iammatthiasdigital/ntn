{
  "name": "@notionhq/custom-blocks-dev-shell",
  "version": "0.1.74",
  "description": "Local preview shell for Notion custom block workers.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "custom-blocks-dev-shell": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "data",
    "dist",
    "dist-cli",
    "docs",
    "README.md"
  ],
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@notionhq/custom-blocks-host": "0.1.19",
    "@notionhq/custom-blocks-protocol": "0.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --project cli/tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json",
    "typecheck": "tsc --project tsconfig.json && tsc --project cli/tsconfig.json"
  }
}