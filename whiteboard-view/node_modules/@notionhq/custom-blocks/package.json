{
	"name": "@notionhq/custom-blocks",
	"version": "0.1.49",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./nds.css": "./dist/styles/nds.css",
		"./react": {
			"import": "./dist/react/index.js",
			"types": "./dist/react/index.d.ts"
		},
		"./testing": {
			"import": "./dist/testing.js",
			"types": "./dist/testing.d.ts"
		},
		"./vite": {
			"import": "./vite-plugin/index.js",
			"types": "./vite-plugin/index.d.ts"
		},
		"./bundle": {
			"types": "./bin/notion-custom-blocks/bundle.d.ts",
			"import": "./bin/notion-custom-blocks/bundle.js"
		}
	},
	"bin": {
		"notion-custom-blocks": "./bin/notion-custom-blocks/cli.js"
	},
	"scripts": {
		"test": "vitest run --environment jsdom",
		"test:coverage": "vitest run --environment jsdom --coverage --coverage.provider=v8 --coverage.reporter=json",
		"typecheck": "tsc --project tsconfig.json && tsc --project notion-custom-blocks/tsconfig.json"
	},
	"files": [
		"src",
		"bin",
		"docs",
		"vite-plugin",
		"dist"
	],
	"peerDependencies": {
		"react": "^19.2.8"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.5.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitest/coverage-v8": "^5.0.0",
		"jsdom": "^30.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"valibot": "^1.4.2"
	}
}
